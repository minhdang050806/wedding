{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(pnpm install *)",
      "PowerShell(pnpm --version)",
      "PowerShell(corepack enable)",
      "PowerShell(corepack prepare pnpm@10 --activate)",
      "PowerShell(npx --yes pnpm@10 install --lockfile-only 2>&1)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(npx next *)",
      "Bash(git count-objects *)"
    ]
  }
}
